generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/user-client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./user.db"
}

enum AssetType {
  STOCKPICKING
  CRYPTO
  DEBENTURE
  INVESTMENT_FUND
  PENSION_FUND
  FII
  ETF
  BDR
  TREASURY
}

model UserProfile {
  id              String        @id @default(cuid())
  displayName     String
  tourCompleted   Boolean       @default(false)
  tourCurrentStep Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accounts        Account[]
  projects        PortfolioProject[]
}

model Account {
  id              String      @id @default(cuid())
  institutionName String
  nickname        String
  currency        String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  userProfileId   String
  userProfile     UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  realAllocations RealPortfolioAsset[]
}

model PortfolioProject {
  id            String      @id @default(cuid())
  name          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  assets        Asset[]
  realPortfolio RealPortfolioAsset[]
}

model Asset {
  id                String           @id @default(cuid())
  type              AssetType
  targetPercentage  Float
  initialValue      Float            @default(0)
  name              String?
  portfolioProjectId String
  portfolioProject  PortfolioProject @relation(fields: [portfolioProjectId], references: [id], onDelete: Cascade)
  realAllocations   RealPortfolioAsset[]
}

model RealPortfolioAsset {
  id                String           @id @default(cuid())
  actualValue       Float
  assetId           String
  asset             Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId         String
  project           PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}
