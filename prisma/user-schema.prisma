generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/user-client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./user.db"
}

enum PortfolioStrategy {
  FREE_ALLOCATION
  ASSET_CLASS_ALLOCATION
}

enum BenchmarkType {
  SP500
  CDI
  IPCA
  IBOVESPA
  NASDAQ100
  BITCOIN
}

enum AssetClass {
  cash_reserve
  fixed_income_post
  fixed_income_pre
  fixed_income_inflation
  debentures
  investment_funds
  retirement_funds
  real_estate_funds
  etf_brazil
  etf_global
  stock_picking_b3
  stock_picking_nasdaq
  stock_picking_nyse
  stock_picking_europe
  stock_picking_asia
  reits
  commodities
  precious_metals
  crypto
  alternative_assets
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  ABANDONED
  COMPLETED
}

enum EventType {
  INVESTMENT_CONTRIBUTION
  ASSET_PURCHASE
  ASSET_SALE
  DIVIDEND_INCOME
  INTEREST_INCOME
  CRYPTO_STAKING
  MANUAL_ADJUSTMENT
}

model UserProfile {
  id                    String            @id @default(cuid())
  displayName           String
  onboardingStatus      OnboardingStatus  @default(NOT_STARTED)
  onboardingCurrentStep Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  accounts              Account[]
  templates             PortfolioTemplate[]
  portfolios            InvestmentPortfolio[]
}

model Account {
  id              String      @id @default(cuid())
  institutionName String
  nickname        String
  currency        String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  userProfileId   String
  userProfile     UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  ledgerEvents    LedgerEvent[]
}

model PortfolioTemplate {
  id            String                  @id @default(cuid())
  name          String
  description   String?
  strategy      PortfolioStrategy       @default(FREE_ALLOCATION)
  benchmark     String?
  baseCurrency  String                  @default("BRL")
  isDefault     Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  userProfileId String
  userProfile   UserProfile             @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  targets       PortfolioAssetTarget[]
  portfolios    InvestmentPortfolio[]
}

model PortfolioAssetTarget {
  id                       String                @id @default(cuid())
  assetClass               AssetClass
  optionalTickerDescription String?
  allocationPercentage     Float
  minimumInvestment        Float                 @default(0)
  fractionalAllowed        Boolean               @default(true)
  lotSize                  Int                   @default(1)
  classTargetId            String?
  classTarget              PortfolioAssetTarget? @relation("ClassTargetHierarchy", fields: [classTargetId], references: [id])
  subTargets               PortfolioAssetTarget[] @relation("ClassTargetHierarchy")
  templateId               String
  template                 PortfolioTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model InvestmentPortfolio {
  id            String                @id @default(cuid())
  name          String
  status        String                @default("ACTIVE")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  userProfileId String
  userProfile   UserProfile           @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  templateId    String
  template      PortfolioTemplate     @relation(fields: [templateId], references: [id])
  assetValues        PortfolioAssetValue[]
  allocationSnapshots AllocationSnapshot[]
  ledgerEvents       LedgerEvent[]
}

model PortfolioAssetValue {
  id                       String                @id @default(cuid())
  assetClass               String
  optionalTickerDescription String?
  targetPercentage         Float
  currentValue             Float                 @default(0)
  classTargetId            String?
  portfolioId              String
  portfolio                InvestmentPortfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ledgerEvents             LedgerEvent[]
}

model AllocationSnapshot {
  id            String              @id @default(cuid())
  portfolioId   String
  portfolio     InvestmentPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  snapshotDate  DateTime
  totalValue    Float
  data          String
  createdAt     DateTime            @default(now())
  @@unique([portfolioId, snapshotDate])
}

model LedgerEvent {
  id            String              @id @default(cuid())
  eventType     EventType
  grossAmount   Float
  feesAmount    Float               @default(0)
  taxAmount     Float               @default(0)
  netAmount     Float
  currency      String
  occurredAt    DateTime
  notes         String?
  createdAt     DateTime            @default(now())
  portfolioId   String
  portfolio     InvestmentPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account             @relation(fields: [accountId], references: [id])
  assetValueId  String
  assetValue    PortfolioAssetValue @relation(fields: [assetValueId], references: [id])
}
